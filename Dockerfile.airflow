FROM apache/airflow:2.8.1-python3.11
USER root
RUN apt-get update && apt-get install -y \
    libgdal-dev \
    gdal-bin \
    libgeos-dev \
    && rm -rf /var/lib/apt/lists/*
USER airflow
RUN pip install --no-cache-dir \
    geopandas==0.14.3 shapely==2.0.3 pyproj==3.6.1 fiona==1.9.5 \
    rasterio==1.3.9 cdsapi==0.7.7 netCDF4==1.6.5 \
    psycopg2-binary==2.9.9 sqlalchemy==2.0.27 \
    scikit-learn==1.4.0 xgboost==2.0.3 lightgbm==4.3.0 shap==0.44.1 \
    mlflow==2.10.2 redis==5.0.1 matplotlib==3.8.2 \
    pytest==8.0.1 \
    fastapi==0.109.2 httpx==0.26.0 uvicorn[standard]==0.27.1