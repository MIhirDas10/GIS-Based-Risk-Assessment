FROM python:3.11-slim

WORKDIR /app

# System libs needed by psycopg2-binary's bundled libs.
# (Avoiding gdal/geos since the API itself doesn't open shapefiles.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps. Pinned to match the rest of the stack so the API
# client/server contracts stay in lock-step.
RUN pip install --no-cache-dir \
    fastapi==0.109.2 \
    uvicorn[standard]==0.27.1 \
    pydantic==2.6.1 \
    psycopg2-binary==2.9.9 \
    sqlalchemy==2.0.27 \
    redis==5.0.1 \
    mlflow==2.10.2 \
    pandas==2.2.0 \
    scikit-learn==1.4.0 \
    xgboost==2.0.3 \
    lightgbm==4.3.0 \
    psutil==5.9.7 \
    python-dotenv==1.0.1

# The compose service bind-mounts ./src into /app, so the container always
# runs the host-edited code. We still copy a fallback so the image is
# self-contained if mounted standalone.
COPY src/api/  /app/api/
COPY src/db.py /app/db.py

# Run from /app with PYTHONPATH so `from db import ...` works both ways:
# - bind-mount mode: /app/api/main.py, /app/db.py
# - copy-only mode: same paths
ENV PYTHONPATH=/app
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
