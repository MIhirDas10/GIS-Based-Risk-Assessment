# Normalise line endings so linting behaves identically on Windows and on the
# Linux CI runners. Ruff's import-sorting rules can report differently against
# CRLF files, which meant a clean local run while CI failed on the same commit.
* text=auto eol=lf

# Binary formats must never be converted.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.xlsx   binary
*.xls    binary
*.tif    binary
*.tiff   binary
*.nc     binary
*.shp    binary
*.shx    binary
*.dbf    binary
*.prj    binary
*.cpg    binary
*.zip    binary
*.gz     binary
